# ─────────────────────────────────────────────────────────────────────────────
# TIMBANG — .gitignore
# Sectioned per docs/SECURITY.md "File yang WAJIB di-.gitignore"
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & credentials (docs/SECURITY.md §Aturan Wajib) ──────────────────
.env
.env.*
!.env.example
mcp.json
*.key
*.pem
*.p12

# ── IBM Bob / editor agent state ─────────────────────────────────────────────
.bob/

# ── Langflow state & exports (rawan credential) ──────────────────────────────
.langflow/

# ── Python artefacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Tool caches ───────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ── Local databases & seed files (never commit local state) ──────────────────
*.db
*.sqlite
*.sqlite3

# ── Frontend build artefacts (reserved for future React frontend) ────────────
node_modules/
dist/
.next/
.nuxt/

# ── OS & editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ── Large binary / docs (bloat repo) ─────────────────────────────────────────
*.pdf

# DB backups
demo.db.backup-*
*.db.backup-*
